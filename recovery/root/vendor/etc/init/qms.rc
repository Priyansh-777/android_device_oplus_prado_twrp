
on post-fs-data
      mkdir /data/vendor/qms 0700 radio radio
      mkdir /data/vendor/qms_logs 0700 radio radio
      mkdir /data/vendor/qms_logs/main 0700 radio radio
      mkdir /data/vendor/qms_logs/other 0700 radio radio
      mkdir /data/vendor/qms_logs/config 0700 radio radio

on property:sys.boot_completed=1
    copy /vendor/etc/SNS_platform_license_for_SM7635.pfm /mnt/vendor/persist/data/pfm/licenses/SNS_platform_license_for_SM7635.pfm
    chmod 0644 /mnt/vendor/persist/data/pfm/licenses/SNS_platform_license_for_SM7635.pfm
    chown system system /mnt/vendor/persist/data/pfm/licenses/SNS_platform_license_for_SM7635.pfm

    copy /vendor/etc/SNS_platform_license_for_SM6650.pfm /mnt/vendor/persist/data/pfm/licenses/SNS_platform_license_for_SM6650.pfm
    chmod 0644 /mnt/vendor/persist/data/pfm/licenses/SNS_platform_license_for_SM6650.pfm
    chown system system /mnt/vendor/persist/data/pfm/licenses/SNS_platform_license_for_SM6650.pfm

service vendor.qms /vendor/bin/qms
     class main
     user radio
     group radio wakelock wifi inet net_admin
     capabilities BLOCK_SUSPEND NET_ADMIN
